flowchart TB
    subgraph ONCE["一次性初始化 (人工执行)"]
        B1["BotFather 建 bot<br/>拿到 BOT_TOKEN"]
        B2{"获取自己 chat id<br/>@userinfobot"}
        B3["创建 gandli 新 repo<br/>clone 本地"]
        B4["gh fine-grained PAT<br/>仅 archive repo · Contents 读写"]
        B5["wrangler kv namespace create CACHE"]
        B6["wrangler secret put<br/>BOT_TOKEN / CHAT_ID / GH_TOKEN"]
        B7["setWebhook 带 secret_token<br/>curl 一次"]
    end

    subgraph DEV["日常开发循环"]
        D1["feature 分支提交"]
        D2["push → 开 PR"]
        D3{"CI: tsc + 139 tests<br/>GitGuardian + dry-run<br/>全绿才合并"}
        D4["review → squash merge"]
        D5["main 落地触发 Actions<br/>wrangler-action deploy"]
        D6["线上验证<br/>发 /trending 实测"]
    end

    subgraph OPS["运维 (基本为零)"]
        O1["wrangler tail 看日志"]
        O2["observability 面板<br/>cron 是否跑过"]
    end

    B1 --> B2 --> B3 --> B4 --> B5 --> B6 --> B7
    B7 -.-> DEV
    D1 --> D2 --> D3
    D3 -->|"失败修复"| D1
    D3 -->|"通过"| D4 --> D5 --> D6
    D6 -.->|"异常时"| O1
    D5 -.-> O2
    D6 -.->|"循环"| D1
