graph TB
    subgraph TG["Telegram"]
        U["用户 gandli<br/>白名单 chat_id"]
        TA["Telegram Bot API<br/>api.telegram.org"]
    end

    subgraph CF["Cloudflare 免费层 (单 Worker daily-digest)"]
        subgraph ENTRY["入口"]
            CRON["⏰ scheduled<br/>cron: 30 0 * * *<br/>北京 08:30 每日"]
            WH["🌐 fetch handler<br/>POST /telegram webhook<br/>GET /run /preview"]
            CBPG["callback_query 分派<br/>arch:pg / sch:page 翻页"]
        end

        subgraph CORE["核心模块 (src/)"]
            SEC["验签<br/>X-Telegram-Bot-Api-Secret-Token"]
            GUARD["chat 白名单守卫"]
            ROUTE["命令路由<br/>/trending /search /archive /help"]
            SRCS["src/sources/<br/>注册表数组"]
            FETCH["fetchTrending()<br/>HTMLRewriter 刮 top10"]
            SEARCH["searchArchive()<br/>search:index 单键索引过滤<br/>+ 当页译中 + 分页"]
            ARCHIVE["renderArchivePage()<br/>archive:idx 倒序 + 三链"]
            LOOKUP["lookup.ts<br/>repo/URL/X 存档管线<br/>seenToday/reproc 去重"]
            TRANS["translate.ts<br/>四级翻译回退<br/>+ CF Summarization 摘要"]
            RENDER["render.ts<br/>Telegram/GitHub/Telegraph<br/>三种渲染"]
            SEND["notify.ts<br/>sendPerRepoMessages 每仓 OG 图<br/>sendTelegramKbd/editMessageKbd"]
            ARCH["archive.ts<br/>GitHub PUT 幂等 + OG图入库"]
            URLMD["urlmd.ts<br/>任意URL→markdown 三级链"]
            FXT["fxtweet.ts<br/>X帖 FxEmbed 存档"]
        end

        CACHE[("KV binding: CACHE<br/>search:index + archive:idx + digest<br/>+ archive:tg + reproc + lookup:desc")]
        AI["Workers AI binding: AI<br/>翻译 + 摘要模型"]

        GW["wrangler.jsonc<br/>KV + ai + crons + observability"]
    end

    subgraph GH["GitHub"]
        TREND["github.com/trending<br/>数据源 (HTML 刮取)"]
        ARCHIVE["gandli/daily-digest<br/>archive 分支 md 存档 + og-images/"]
        REPO["bot 源码 repo<br/>PR → main → Actions 自动 deploy"]
    end

    subgraph EXT["外部服务"]
        TGEXT["telegra.ph<br/>每日备份页"]
        WA["web.archive.org<br/>兜底快照三链"]
        DW["deepwiki / zread<br/>描绘来源"]
        MM["TranSmart / MyMemory<br/>免 key 翻译回退"]
    end

    %% cron 流
    CRON -->|"runDigest()"| FETCH
    FETCH -->|"GET"| TREND
    FETCH --> TRANS
    TRANS -.->|"desc 来源"| DW
    TRANS -.->|"翻译回退"| MM
    TRANS -->|"onsite"| AI
    TRANS --> RENDER
    RENDER --> SEND
    SEND -->|"每仓 sendPhoto OG 图"| TA
    TA --> U
    RENDER -->|"写入"| CACHE
    RENDER -->|"PUT archive/YYYY/date.md"| ARCH
    ARCH -->|"commit"| GH(ARCHIVE)
    RENDER -.->|"createPage"| TGEXT

    %% webhook 命令流
    U -->|"/search /archive /trending 等"| TA
    TA -->|"POST /telegram"| WH
    WH --> SEC --> GUARD --> ROUTE
    ROUTE -->|"/search"| SEARCH
    ROUTE -->|"/archive"| ARCHIVE
    ROUTE -->|"repo/URL/X 链接"| LOOKUP
    ROUTE -->|"/trending 缓存"| CACHE
    SEARCH -->|"读 search:index"| CACHE
    SEARCH -->|"描述译中"| TRANS
    ARCHIVE -->|"archive:idx + 三链"| CACHE
    ARCHIVE -.->|"web.archive 链"| WA
    ARCHIVE -.->|"telegraph 链"| TGEXT
    LOOKUP -->|"读取 seenToday/lookup:desc"| CACHE
    LOOKUP -->|"存档"| ARCH
    CBPG -->|"editMessageText 翻页"| SEND

    %% 部署流
    REPO -.->|"CI deploy"| GW