{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-digest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  // 以下资源 ID 均为 gandli 账号私有 —— fork 部署者必须换成自己账号的资源:
  //   wrangler kv namespace create CACHE && wrangler d1 create daily-digest-archive
  //   wrangler vectorize create daily-digest-search --dimensions 384 --metric cosine
  //   ratelimits 无需 CLI 创建 —— 直接在下方配置即可 (namespace_id 是自定整数标识)
  "kv_namespaces": [
    { "binding": "CACHE", "id": "51e73f8381d34b9c95eaebdf4f7d8101" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "daily-digest-archive", "database_id": "b8a4db90-1429-43cd-9f2a-8c3f07828acc" }
  ],
  "vectorize": [
    { "binding": "VEC", "index_name": "daily-digest-search" }
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": {
    "crons": ["30 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}