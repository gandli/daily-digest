{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-digest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "0b15c9a68d924b77a5c427e7c9232763" }
  ],
  "triggers": {
    "crons": ["30 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
